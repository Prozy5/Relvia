<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Staff Offices — Relvia</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  --background:#0a0806; --glass:#120e09; --surface-light:#161008; --surface:#1c150d;
  --border:#2a2018; --border-soft:#1c1610; --gold-start:#f2c766; --gold-end:#b9832f; --gold:#e0b158;
  --text:#f5f1ea; --muted:#a89e8f; --muted-soft:#6b6255; --danger:#e0574f;
  --font-display:"Playfair Display",serif; --font-body:"Inter",sans-serif;
}
*{ margin:0; padding:0; box-sizing:border-box; font-family:var(--font-body); }
body{ color:var(--text); min-height:100vh; background:var(--background); }
a{ text-decoration:none; color:inherit; }
button, input, textarea{ font-family:inherit; }
button{ cursor:pointer; border:none; background:none; color:inherit; font-size:inherit; }

.topbar{
  position:sticky; top:0; height:72px; display:flex; align-items:center; justify-content:space-between;
  padding:0 32px; background:rgba(5,5,5,.85); backdrop-filter:blur(18px); border-bottom:1px solid var(--border-soft); z-index:50;
}
.brand{ display:flex; align-items:center; gap:12px; }
.brand-badge{
  width:36px; height:36px; border-radius:50%; background:#000; border:1.5px solid var(--gold-end);
  display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-style:italic; font-weight:700; font-size:18px; color:var(--gold-start);
}
.brand-name{ font-family:var(--font-display); font-weight:700; font-size:19px; }
.back-link{ font-size:13px; font-weight:700; color:var(--muted); }
.back-link:hover{ color:var(--gold); }

.container{ max-width:760px; margin:auto; padding:50px 24px 90px; }
.page-eyebrow{ font-size:11px; letter-spacing:3px; color:var(--gold); text-transform:uppercase; font-weight:800; margin-bottom:12px; text-align:center; }
.page-title{ font-family:var(--font-display); font-size:clamp(28px,4vw,40px); font-weight:600; text-align:center; margin-bottom:12px; }
.page-sub{ text-align:center; color:var(--muted); font-size:14px; line-height:1.7; max-width:480px; margin:0 auto 36px; }

.office-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:16px; }
.office-card{
  background:linear-gradient(155deg,#16110a,#0e0b07 60%); border:1px solid var(--border); border-radius:18px;
  padding:22px; display:flex; flex-direction:column; gap:14px; transition:border-color .2s, transform .2s;
}
.office-card:hover{ border-color:rgba(217,169,75,.4); transform:translateY(-2px); }
.office-card-top{ display:flex; gap:14px; align-items:center; }
.avatar{
  width:52px; height:52px; border-radius:50%; background:var(--surface-light); border:1.5px solid var(--gold-end);
  display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0;
  font-family:var(--font-display); font-size:20px; color:var(--gold);
}
.avatar img{ width:100%; height:100%; object-fit:cover; }
.office-name{ font-family:var(--font-display); font-size:18px; font-weight:600; }
.office-staff{ font-size:12.5px; color:var(--muted); margin-top:2px; }
.office-title-tag{ display:inline-block; font-size:10px; font-weight:800; letter-spacing:.5px; text-transform:uppercase; color:var(--gold); border:1px solid var(--gold-end); padding:2px 10px; border-radius:999px; }
.enter-btn{ font-size:13px; font-weight:800; padding:10px 18px; border-radius:10px; background:linear-gradient(135deg,var(--gold-start),var(--gold-end)); color:#000; align-self:flex-start; }

.empty-state{ text-align:center; color:var(--muted); padding:60px 20px; font-size:14px; line-height:1.7; }
.loading-state{ text-align:center; color:var(--muted); padding:60px 0; }

/* ROOM */
.room-back{ font-size:13px; font-weight:700; color:var(--muted); display:inline-block; margin-bottom:18px; }
.room-back:hover{ color:var(--gold); }
.room-head{ display:flex; gap:14px; align-items:center; margin-bottom:8px; }
.room-notice{ font-size:11.5px; color:var(--muted-soft); line-height:1.6; margin-bottom:16px; }
.chat-box{
  background:#0d0a07; border:1px solid var(--border); border-radius:16px; height:420px; overflow-y:auto;
  padding:18px; display:flex; flex-direction:column; gap:10px; margin-bottom:12px;
}
.bubble{ max-width:78%; padding:10px 14px; border-radius:14px; font-size:13.5px; line-height:1.55; white-space:pre-wrap; word-wrap:break-word; }
.bubble.mine{ align-self:flex-end; background:linear-gradient(135deg,var(--gold-start),var(--gold-end)); color:#000; border-bottom-right-radius:4px; }
.bubble.theirs{ align-self:flex-start; background:var(--surface); border:1px solid var(--border); border-bottom-left-radius:4px; }
.bubble-time{ font-size:10px; opacity:.6; margin-top:4px; }
.chat-empty{ margin:auto; color:var(--muted-soft); font-size:13px; text-align:center; }
.composer{ display:flex; gap:10px; }
.composer input{ flex:1; background:var(--surface-light); border:1px solid var(--border); border-radius:12px; padding:12px 14px; color:white; font-size:14px; }
.composer button{ font-size:13px; font-weight:800; padding:0 22px; border-radius:12px; background:linear-gradient(135deg,var(--gold-start),var(--gold-end)); color:#000; }
.composer button:disabled{ opacity:.5; cursor:default; }
.room-error{ color:var(--danger); font-size:12.5px; min-height:18px; margin-top:8px; }
</style>
</head>
<body>

<header class="topbar">
  <a class="brand" href="/index.html">
    <div class="brand-badge">R</div>
    <span class="brand-name">Relvia&trade;</span>
  </a>
  <a class="back-link" href="/index.html">← Relvia</a>
</header>

<div class="container" id="container">
  <div class="loading-state">Loading...</div>
</div>

<script>

const SUPABASE_URL = "https://nqcbhpqzzwjgkusfbexo.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5xY2JocHF6endqZ2t1c2ZiZXhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzNjY1NjEsImV4cCI6MjA5ODk0MjU2MX0.BphyIGT-X9ctYVvfYXw_ldo5XGguNv5j-zDiGBPrCVU";

const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let currentUser = null;
let activeChannel = null;
const renderedIds = new Set();

function escapeHtml(str){
  return (str || "").replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
}
function avatarInner(url, name){
  if (url) return `<img src="${escapeHtml(url)}">`;
  return escapeHtml((name || "?").charAt(0).toUpperCase());
}
function formatTime(dateStr){
  return new Date(dateStr).toLocaleTimeString([], { hour:"numeric", minute:"2-digit" });
}

async function initialize(){
  const { data: sessionData } = await supabaseClient.auth.getSession();
  if (!sessionData?.session){ window.location.href = "/login.html"; return; }
  const { data: userData } = await supabaseClient.auth.getUser();
  if (!userData?.user){ window.location.href = "/login.html"; return; }
  currentUser = userData.user;

  await renderOfficeList();
}

function leaveChannel(){
  if (activeChannel){ supabaseClient.removeChannel(activeChannel); activeChannel = null; }
}

async function renderOfficeList(){
  leaveChannel();
  const container = document.getElementById("container");
  container.innerHTML = `<div class="loading-state">Loading...</div>`;

  const { data: offices, error } = await supabaseClient
    .from("staff_offices").select("*").eq("is_open", true).order("created_at", { ascending:true });

  const header = `
    <div class="page-eyebrow">Relvia</div>
    <div class="page-title">Staff Offices</div>
    <p class="page-sub">Walk into an open office to talk with a member of the team directly.</p>`;

  if (error){ container.innerHTML = header + `<div class="empty-state">Couldn't load offices right now.</div>`; return; }
  if (!offices || offices.length === 0){
    container.innerHTML = header + `<div class="empty-state">No offices are open right now.<br>Check back soon.</div>`;
    return;
  }

  const staffIds = offices.map(o => o.staff_id);
  const { data: profiles } = await supabaseClient.from("profiles").select("id, display_name, username, avatar_url").in("id", staffIds);
  const profileById = {};
  (profiles || []).forEach(p => { profileById[p.id] = p; });

  container.innerHTML = header + `<div class="office-grid" id="officeGrid"></div>`;
  const grid = document.getElementById("officeGrid");

  offices.forEach(office => {
    const staff = profileById[office.staff_id];
    const card = document.createElement("div");
    card.className = "office-card";
    card.innerHTML = `
      <div class="office-card-top">
        <div class="avatar">${avatarInner(staff?.avatar_url, staff?.display_name)}</div>
        <div>
          <div class="office-name">${escapeHtml(office.office_name)}</div>
          <div class="office-staff">${escapeHtml(staff?.display_name || "Staff")}</div>
        </div>
      </div>
      ${office.title ? `<div><span class="office-title-tag">${escapeHtml(office.title)}</span></div>` : ""}
      <button class="enter-btn">Enter office</button>`;
    card.querySelector(".enter-btn").addEventListener("click", () => enterOffice(office, staff));
    grid.appendChild(card);
  });
}

async function enterOffice(office, staff){
  leaveChannel();
  renderedIds.clear();

  const container = document.getElementById("container");
  container.innerHTML = `
    <a href="#" class="room-back" id="roomBack">← All offices</a>
    <div class="room-head">
      <div class="avatar">${avatarInner(staff?.avatar_url, staff?.display_name)}</div>
      <div>
        <div class="office-name">${escapeHtml(office.office_name)}</div>
        <div class="office-staff">${escapeHtml(staff?.display_name || "Staff")}${office.title ? ` · ${escapeHtml(office.title)}` : ""}</div>
      </div>
    </div>
    <div class="room-notice">Only you and this staff member can see this conversation. They can see your public profile and activity counts while you chat.</div>
    <div class="chat-box" id="chatBox"></div>
    <div class="composer">
      <input type="text" id="messageInput" placeholder="Write a message..." maxlength="2000">
      <button id="sendBtn">Send</button>
    </div>
    <div class="room-error" id="roomError"></div>`;

  document.getElementById("roomBack").addEventListener("click", (e) => { e.preventDefault(); renderOfficeList(); });

  const { data: messages } = await supabaseClient
    .from("office_messages").select("*")
    .eq("office_id", office.id).eq("visitor_id", currentUser.id)
    .order("created_at", { ascending:true });

  const chatBox = document.getElementById("chatBox");
  if (!messages || messages.length === 0){
    chatBox.innerHTML = `<div class="chat-empty" id="chatEmpty">Say hello — they'll see your message as soon as they're free.</div>`;
  } else {
    messages.forEach(appendMessage);
  }

  activeChannel = supabaseClient
    .channel(`office-room-${office.id}-${currentUser.id}`)
    .on("postgres_changes",
      { event: "INSERT", schema: "public", table: "office_messages", filter: `office_id=eq.${office.id}` },
      (payload) => { if (payload.new.visitor_id === currentUser.id) appendMessage(payload.new); })
    .subscribe();

  const input = document.getElementById("messageInput");
  const sendBtn = document.getElementById("sendBtn");
  const send = async () => {
    const body = input.value.trim();
    if (!body) return;
    sendBtn.disabled = true;
    document.getElementById("roomError").textContent = "";

    const { data: sent, error } = await supabaseClient
      .from("office_messages")
      .insert({ office_id: office.id, visitor_id: currentUser.id, sender_id: currentUser.id, body })
      .select().single();

    sendBtn.disabled = false;
    if (error){
      const msg = (error.message || "").toLowerCase();
      document.getElementById("roomError").textContent =
        msg.includes("slow down") ? "You're sending messages too fast. Wait a minute and try again."
        : msg.includes("row-level security") ? "This office just closed. Try again later."
        : "Couldn't send that message.";
      return;
    }
    input.value = "";
    appendMessage(sent);
  };
  sendBtn.addEventListener("click", send);
  input.addEventListener("keydown", (e) => { if (e.key === "Enter") send(); });
  input.focus();
}

function appendMessage(m){
  if (renderedIds.has(m.id)) return;
  renderedIds.add(m.id);

  const chatBox = document.getElementById("chatBox");
  if (!chatBox) return;
  const empty = document.getElementById("chatEmpty");
  if (empty) empty.remove();

  const mine = m.sender_id === currentUser.id;
  const bubble = document.createElement("div");
  bubble.className = `bubble ${mine ? "mine" : "theirs"}`;
  bubble.innerHTML = `${escapeHtml(m.body)}<div class="bubble-time">${formatTime(m.created_at)}</div>`;
  chatBox.appendChild(bubble);
  chatBox.scrollTop = chatBox.scrollHeight;
}

initialize();
</script>
<script src="beta-toolkit.js"></script>
</body>
</html>
