<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Owner Panel — Relvia Live</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  --background:#0a0806; --glass:rgba(18,14,10,.6); --surface-light:#1c150d; --surface:rgba(20,16,11,.78);
  --border:#2a2018; --border-soft:#1c1610; --gold-start:#f2c766; --gold-end:#b9832f; --gold:#e0b158;
  --text:#f5f1ea; --muted:#a89e8f; --muted-soft:#6b6255; --live-red:#e0574f; --ok-green:#5fae7a;
  --font-display:"Playfair Display",serif; --font-body:"Inter",sans-serif;
}
*{ margin:0; padding:0; box-sizing:border-box; font-family:var(--font-body); }
body{
  min-height:100vh; color:var(--text);
  background:
    radial-gradient(ellipse 900px 500px at 15% -5%, rgba(217,169,75,.10), transparent 60%),
    var(--background);
}
button, input{ font-family:inherit; }
button{ cursor:pointer; border:none; background:none; color:inherit; font-size:inherit; }

.gate-screen{ min-height:100vh; display:none; align-items:center; justify-content:center; padding:24px; }
.gate-card{
  background:var(--glass); border:1px solid var(--border); border-radius:24px;
  padding:50px 40px; text-align:center; max-width:440px;
}
.gate-card .icon{ font-size:26px; color:var(--gold); margin-bottom:12px; }
.gate-card h1{ font-family:var(--font-display); font-size:24px; margin-bottom:10px; }
.gate-card p{ color:var(--muted); font-size:14px; line-height:1.6; }
.gate-card a{
  display:inline-block; margin-top:22px; color:var(--gold); text-decoration:none;
  border:1px solid var(--gold-end); padding:10px 20px; border-radius:12px; font-weight:700; font-size:13.5px;
}
.gate-card a:hover{ background:var(--gold); color:#000; }

#dashboard{ display:none; }

.topbar{
  position:sticky; top:0; height:72px; display:flex; align-items:center; justify-content:space-between;
  padding:0 30px; background:rgba(5,5,5,.85); backdrop-filter:blur(18px); border-bottom:1px solid var(--border-soft);
  z-index:50;
}
.brand{ display:flex; align-items:center; gap:12px; }
.brand-badge{
  width:34px; height:34px; border-radius:50%; background:#000;
  background-image:radial-gradient(circle at 32% 22%, rgba(242,199,102,.28), transparent 65%);
  border:1.5px solid var(--gold-end); display:flex; align-items:center; justify-content:center;
  font-family:var(--font-display); font-style:italic; font-weight:700; font-size:17px; color:var(--gold-start);
}
.brand-name{ font-family:var(--font-display); font-weight:700; font-size:17px; }
.badge-label{
  background:linear-gradient(135deg,var(--gold-start),var(--gold-end)); color:#000;
  font-size:10.5px; font-weight:800; padding:4px 11px; border-radius:999px; margin-left:8px;
}
.back-link{ font-size:13px; font-weight:700; color:var(--muted); text-decoration:none; }
.back-link:hover{ color:var(--gold); }

.container{ max-width:1400px; margin:auto; padding:30px; }

.stats-row{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:34px; }
.stat-card{ background:var(--glass); border:1px solid var(--border); border-radius:18px; padding:20px; }
.stat-card .num{ font-size:28px; font-weight:800; font-family:var(--font-display); }
.stat-card .label{ font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin-top:4px; }

.section{ margin-bottom:40px; }
.section-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
.section-head h2{ font-family:var(--font-display); font-size:22px; font-weight:600; }

.panel{ background:var(--glass); border:1px solid var(--border); border-radius:18px; overflow:hidden; }
table{ width:100%; border-collapse:collapse; }
th{
  text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.8px; color:var(--muted);
  padding:14px 18px; border-bottom:1px solid var(--border); font-weight:700;
}
td{ padding:14px 18px; border-bottom:1px solid var(--border-soft); font-size:13.5px; vertical-align:middle; }
tr:last-child td{ border-bottom:none; }
.empty-row td{ color:var(--muted); text-align:center; padding:30px; }

.pill{ display:inline-block; font-size:11px; font-weight:700; padding:4px 10px; border-radius:999px; }
.pill.live{ background:rgba(224,87,79,.15); color:#f2a8a3; }
.pill.featured{ background:rgba(217,169,75,.15); color:var(--gold); }

.btn{
  font-size:12.5px; font-weight:700; padding:8px 14px; border-radius:10px; transition:.15s;
  border:1px solid var(--border); background:var(--surface-light); color:var(--text); margin-right:6px;
}
.btn:hover{ border-color:var(--gold); color:var(--gold); }
.btn.danger:hover{ border-color:var(--live-red); color:#f2a8a3; }
.btn.gold{ background:linear-gradient(135deg,var(--gold-start),var(--gold-end)); color:#000; border:none; }
.btn.gold:hover{ opacity:.85; }

.toggle-btn{
  font-size:11.5px; font-weight:700; padding:6px 12px; border-radius:8px; border:1px solid var(--border);
  background:var(--surface-light); color:var(--muted);
}
.toggle-btn.on{ border-color:var(--live-red); color:#f2a8a3; background:rgba(224,87,79,.1); }

.add-form{ display:flex; gap:10px; padding:16px 18px; border-top:1px solid var(--border); flex-wrap:wrap; }
.add-form input{
  background:var(--surface-light); border:1px solid var(--border); border-radius:10px;
  padding:9px 13px; color:white; font-size:13px;
}
.add-form input:focus{ outline:none; border-color:var(--gold); }

.toast{
  position:fixed; bottom:28px; left:50%; transform:translateX(-50%) translateY(20px);
  background:var(--surface); border:1px solid var(--gold); color:white;
  padding:13px 22px; border-radius:14px; font-size:13.5px; font-weight:600;
  opacity:0; pointer-events:none; transition:.25s; z-index:3000;
}
.toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

@media(max-width:900px){
  .stats-row{ grid-template-columns:repeat(2,1fr); }
  .panel{ overflow-x:auto; }
  table{ min-width:640px; }
}
</style>
</head>
<body>

<div class="gate-screen" id="deniedScreen">
  <div class="gate-card">
    <div class="icon">✦</div>
    <h1>Owners only</h1>
    <p>This panel is restricted to Relvia Live owners.</p>
    <a href="live.html">Back to Relvia Live</a>
  </div>
</div>

<div id="dashboard">

  <header class="topbar">
    <div class="brand">
      <div class="brand-badge">R</div>
      <span class="brand-name">Owner Panel</span>
      <span class="badge-label" id="badgeLabel"></span>
    </div>
    <a class="back-link" href="live.html">← Back to Relvia Live</a>
  </header>

  <div class="container">

    <div class="stats-row">
      <div class="stat-card"><div class="num" id="statLiveNow">—</div><div class="label">Live Now</div></div>
      <div class="stat-card"><div class="num" id="statCategories">—</div><div class="label">Categories</div></div>
      <div class="stat-card"><div class="num" id="statTotalStreams">—</div><div class="label">Total Streams</div></div>
      <div class="stat-card"><div class="num" id="statBanned">—</div><div class="label">Banned Users</div></div>
    </div>

    <div class="section">
      <div class="section-head"><h2>Live Streams</h2></div>
      <div class="panel">
        <table>
          <thead><tr><th>Title</th><th>Category</th><th>Viewers</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody id="streamsTableBody"><tr class="empty-row"><td colspan="5">Loading...</td></tr></tbody>
        </table>
      </div>
    </div>

    <div class="section">
      <div class="section-head"><h2>Categories</h2></div>
      <div class="panel">
        <table>
          <thead><tr><th>Name</th><th>Order</th><th>Actions</th></tr></thead>
          <tbody id="categoriesTableBody"><tr class="empty-row"><td colspan="3">Loading...</td></tr></tbody>
        </table>
        <div class="add-form">
          <input type="text" id="newCategoryName" placeholder="New category name">
          <input type="number" id="newCategorySort" placeholder="Sort order" style="width:110px;">
          <button class="btn gold" id="addCategoryBtn">Add category</button>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-head"><h2>Users</h2></div>
      <div class="panel">
        <table>
          <thead><tr><th>Name</th><th>Username</th><th>Streaming</th><th>Watching</th></tr></thead>
          <tbody id="usersTableBody"><tr class="empty-row"><td colspan="4">Loading...</td></tr></tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<div class="toast" id="toast"></div>

<script>

const SUPABASE_URL = "https://nqcbhpqzzwjgkusfbexo.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5xY2JocHF6endqZ2t1c2ZiZXhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzNjY1NjEsImV4cCI6MjA5ODk0MjU2MX0.BphyIGT-X9ctYVvfYXw_ldo5XGguNv5j-zDiGBPrCVU";
const END_STREAM_ENDPOINT = `${SUPABASE_URL}/functions/v1/owner-end-stream`;

const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
  auth: { storageKey: "relvia-live-auth" }
});

let currentUser = null;

function showToast(message){
  const toast = document.getElementById("toast");
  toast.textContent = message;
  toast.classList.add("show");
  setTimeout(() => toast.classList.remove("show"), 2400);
}

function escapeHtml(str){
  return (str || "").replace(/[&<>"']/g, m => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
}

async function gate(){
  const { data: sessionData } = await supabaseClient.auth.getSession();
  if (!sessionData || !sessionData.session){ window.location.href = "live-login.html"; return; }

  const { data: userData } = await supabaseClient.auth.getUser();
  if (!userData.user){ window.location.href = "live-login.html"; return; }

  currentUser = userData.user;

  const { data: owner } = await supabaseClient
    .from("live_owners")
    .select("badge_label")
    .eq("user_id", currentUser.id)
    .maybeSingle();

  if (!owner){
    document.getElementById("deniedScreen").style.display = "flex";
    return;
  }

  document.getElementById("badgeLabel").textContent = owner.badge_label || "Owner";
  document.getElementById("dashboard").style.display = "block";

  await Promise.all([loadStreams(), loadCategories(), loadUsers()]);
  await loadStats();

  document.getElementById("addCategoryBtn").addEventListener("click", addCategory);
}

async function loadStats(){
  const [liveNow, categories, totalStreams, banned] = await Promise.all([
    supabaseClient.from("live_streams").select("id", { count: "exact", head: true }).eq("is_live", true),
    supabaseClient.from("live_categories").select("id", { count: "exact", head: true }),
    supabaseClient.from("live_streams").select("id", { count: "exact", head: true }),
    supabaseClient.from("live_profiles").select("id", { count: "exact", head: true })
      .or("banned_from_streaming.eq.true,banned_from_watching.eq.true"),
  ]);

  document.getElementById("statLiveNow").textContent = liveNow.count ?? 0;
  document.getElementById("statCategories").textContent = categories.count ?? 0;
  document.getElementById("statTotalStreams").textContent = totalStreams.count ?? 0;
  document.getElementById("statBanned").textContent = banned.count ?? 0;
}

async function loadStreams(){
  const tbody = document.getElementById("streamsTableBody");

  const { data: streams, error } = await supabaseClient
    .from("live_streams")
    .select("*, live_categories(name)")
    .eq("is_live", true)
    .order("featured", { ascending:false })
    .order("viewer_count", { ascending:false });

  if (error){ console.error(error); tbody.innerHTML = `<tr class="empty-row"><td colspan="5">Couldn't load streams.</td></tr>`; return; }

  if (!streams || streams.length === 0){
    tbody.innerHTML = `<tr class="empty-row"><td colspan="5">Nothing is live right now.</td></tr>`;
    return;
  }

  tbody.innerHTML = "";
  streams.forEach(stream => {
    const row = document.createElement("tr");
    row.innerHTML = `
      <td>${escapeHtml(stream.title)}</td>
      <td>${escapeHtml(stream.live_categories?.name || "Uncategorized")}</td>
      <td>${stream.viewer_count || 0}</td>
      <td>
        <span class="pill live">LIVE</span>
        ${stream.featured ? `<span class="pill featured">Featured</span>` : ""}
      </td>
      <td>
        <button class="btn" data-action="feature">${stream.featured ? "Unfeature" : "Feature"}</button>
        <button class="btn danger" data-action="end">End stream</button>
        <button class="btn danger" data-action="delete">Delete</button>
      </td>`;

    row.querySelector('[data-action="feature"]').addEventListener("click", () => toggleFeatured(stream.id, !stream.featured));
    row.querySelector('[data-action="end"]').addEventListener("click", () => endStream(stream.id, stream.title));
    row.querySelector('[data-action="delete"]').addEventListener("click", () => deleteStream(stream.id, stream.title, stream.is_live));

    tbody.appendChild(row);
  });
}

async function toggleFeatured(streamId, newValue){
  const { error } = await supabaseClient.from("live_streams").update({ featured: newValue }).eq("id", streamId);
  if (error){ console.error(error); showToast("Couldn't update featured status"); return; }
  showToast(newValue ? "Stream featured" : "Stream unfeatured");
  await loadStreams();
}

async function endStream(streamId, title){
  if (!confirm(`End "${title}" now? This disconnects the broadcaster and all viewers immediately.`)) return;

  const { data: sessionData } = await supabaseClient.auth.getSession();
  const accessToken = sessionData?.session?.access_token;

  try {
    const response = await fetch(END_STREAM_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json", "Authorization": `Bearer ${accessToken}` },
      body: JSON.stringify({ streamId }),
    });
    const result = await response.json();

    if (!response.ok){ showToast(result.error || "Couldn't end stream"); return; }

    showToast("Stream ended");
    await Promise.all([loadStreams(), loadStats()]);
  } catch (err){
    console.error(err);
    showToast("Couldn't reach the server to end the stream");
  }
}

async function deleteStream(streamId, title, isLive){
  if (isLive){ showToast("End the stream before deleting its record"); return; }
  if (!confirm(`Permanently delete the record for "${title}"?`)) return;

  const { error } = await supabaseClient.from("live_streams").delete().eq("id", streamId);
  if (error){ console.error(error); showToast("Couldn't delete stream"); return; }
  showToast("Stream record deleted");
  await Promise.all([loadStreams(), loadStats()]);
}

async function loadCategories(){
  const tbody = document.getElementById("categoriesTableBody");

  const { data, error } = await supabaseClient
    .from("live_categories")
    .select("*")
    .order("sort_order", { ascending:true });

  if (error){ console.error(error); tbody.innerHTML = `<tr class="empty-row"><td colspan="3">Couldn't load categories.</td></tr>`; return; }

  if (!data || data.length === 0){
    tbody.innerHTML = `<tr class="empty-row"><td colspan="3">No categories yet.</td></tr>`;
    return;
  }

  tbody.innerHTML = "";
  data.forEach(cat => {
    const row = document.createElement("tr");
    row.innerHTML = `
      <td>${escapeHtml(cat.name)}</td>
      <td>${cat.sort_order}</td>
      <td><button class="btn danger" data-action="delete">Delete</button></td>`;
    row.querySelector('[data-action="delete"]').addEventListener("click", () => deleteCategory(cat.id, cat.name));
    tbody.appendChild(row);
  });
}

async function addCategory(){
  const nameInput = document.getElementById("newCategoryName");
  const sortInput = document.getElementById("newCategorySort");
  const name = nameInput.value.trim();
  const sort_order = parseInt(sortInput.value, 10) || 0;

  if (!name){ showToast("Enter a category name"); return; }

  const { error } = await supabaseClient.from("live_categories").insert({ name, sort_order });
  if (error){ console.error(error); showToast("Couldn't add category"); return; }

  nameInput.value = ""; sortInput.value = "";
  showToast("Category added");
  await Promise.all([loadCategories(), loadStats()]);
}

async function deleteCategory(categoryId, name){
  if (!confirm(`Delete category "${name}"? Streams in it will become uncategorized.`)) return;

  const { error } = await supabaseClient.from("live_categories").delete().eq("id", categoryId);
  if (error){ console.error(error); showToast("Couldn't delete category"); return; }
  showToast("Category deleted");
  await Promise.all([loadCategories(), loadStats()]);
}

async function loadUsers(){
  const tbody = document.getElementById("usersTableBody");

  const { data, error } = await supabaseClient
    .from("live_profiles")
    .select("*")
    .order("created_at", { ascending:false })
    .limit(100);

  if (error){ console.error(error); tbody.innerHTML = `<tr class="empty-row"><td colspan="4">Couldn't load users.</td></tr>`; return; }

  if (!data || data.length === 0){
    tbody.innerHTML = `<tr class="empty-row"><td colspan="4">No users yet.</td></tr>`;
    return;
  }

  tbody.innerHTML = "";
  data.forEach(user => {
    const row = document.createElement("tr");
    row.innerHTML = `
      <td>${escapeHtml(user.display_name)}</td>
      <td>@${escapeHtml(user.username)}</td>
      <td><button class="toggle-btn ${user.banned_from_streaming ? "on" : ""}" data-action="streaming">${user.banned_from_streaming ? "Banned" : "Allowed"}</button></td>
      <td><button class="toggle-btn ${user.banned_from_watching ? "on" : ""}" data-action="watching">${user.banned_from_watching ? "Banned" : "Allowed"}</button></td>`;

    row.querySelector('[data-action="streaming"]').addEventListener("click", () => toggleBan(user.id, "banned_from_streaming", !user.banned_from_streaming));
    row.querySelector('[data-action="watching"]').addEventListener("click", () => toggleBan(user.id, "banned_from_watching", !user.banned_from_watching));

    tbody.appendChild(row);
  });
}

async function toggleBan(userId, field, newValue){
  if (newValue && !confirm(`Set ${field.replace(/_/g, " ")} for this user?`)) return;

  const { error } = await supabaseClient.from("live_profiles").update({ [field]: newValue }).eq("id", userId);
  if (error){ console.error(error); showToast("Couldn't update user"); return; }
  showToast("User updated");
  await Promise.all([loadUsers(), loadStats()]);
}

gate();
</script>
</body>
</html>
